#!/bin/bash
# pre-commit 钩子：文档守卫。
#
# `node scripts/docs.mjs --check` 任一项不过即非零退出，拦下本次提交：
#   - log.md 周期块超过保留上限（写了新块却忘了归档）→ 跑 `npm run docs` 后 `git add` 重提；
#   - 索引 ↔ 分节文件不一致、相对链接 / 锚点失效、目录树与磁盘不符 → 按报错手动修缮对应文件。
#
# 启用方式（已由 .claude/hooks/session-start.sh 在远程会话自动设置）：
#   git config core.hooksPath .githooks
#
# 跳过本次检查（仅在确有必要时）：git commit --no-verify
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# 本次没有暂存改动就不必检查。
staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -z "$staged" ] && exit 0

# 本仓库是单一项目（非 monorepo），文档维护脚本固定在仓库根 scripts/docs.mjs。
if [ ! -f "$REPO_ROOT/scripts/docs.mjs" ]; then
	exit 0
fi

echo "==> 文档守卫"
if ! (cd "$REPO_ROOT" && node scripts/docs.mjs --check); then
	echo ""
	echo "✗ 提交被拦下：文档守卫未通过。请按提示修复后重试（或 git commit --no-verify 跳过）。"
	exit 1
fi
exit 0
